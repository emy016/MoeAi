# ── AI providers (server-only) ──────────────────────────────────────────
# Tried in this order; the first key that answers wins.
#
# Each of these may hold SEVERAL keys, separated by commas. That is how free
# tiers are survived: when one key is exhausted the next is tried, rather than
# the answer failing. The singular names below (GEMINI_API_KEY and friends)
# also work and mean the same thing — both are read everywhere.
#
#   GEMINI_API_KEYS=AIza...one,AIza...two
#
# The Gemini key must start with AIza and come from aistudio.google.com. A
# value starting AQ. is an OAuth access token, not an API key: it expires in
# about an hour and will stop working mid-demo.
GEMINI_API_KEYS=
GROQ_API_KEYS=
# More providers: the chat falls back to them when every Gemini key is busy,
# and background jobs (memory, summaries, MoeAI's nightly review) use them first.
OPENROUTER_API_KEYS=

# Leave empty: MoeAI asks Google which models the keys can use and ranks them.
GEMINI_MODEL=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# NVIDIA (build.nvidia.com → Get API Key), OpenAI-compatible.
NVIDIA_API_KEYS=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Cheaper Inference (paid, OpenAI-compatible): only used when every free provider fails.
CHEAPER_INFERENCE_API_KEYS=
CHEAPER_INFERENCE_MODEL=gpt-5.4-mini
# Provider order for practice, quizzes and the organizer (Gemini first);
# for background jobs; and for the chat after Gemini. All optional.
AI_PROVIDER_ORDER=gemini,groq,openrouter,nvidia,cheaper
BACKGROUND_PROVIDER_ORDER=groq,nvidia,openrouter,gemini,cheaper
CHAT_FALLBACK_ORDER=groq,nvidia,openrouter,cheaper

# ── Supabase ────────────────────────────────────────────────────────────
# The first two are public by design and safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ── Limits ──────────────────────────────────────────────────────────────
MOEAI_MAX_MESSAGES_PER_HOUR=40

# ── Cron ────────────────────────────────────────────────────────────────
# Vercel sends this as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://moe-ai-sable.vercel.app

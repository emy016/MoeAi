# ── AI providers (server-only) ──────────────────────────────────────────
# Tried in this order; the first key that answers wins.
#
# Each of these may hold SEVERAL keys, separated by commas. That is how free
# tiers are survived: when one key is exhausted the next is tried, rather than
# the answer failing. The singular names below (GEMINI_API_KEY and friends)
# also work and mean the same thing — both are read everywhere.
#
#   GEMINI_API_KEYS=AIza...one,AIza...two
#
# The Gemini key must start with AIza and come from aistudio.google.com. A
# value starting AQ. is an OAuth access token, not an API key: it expires in
# about an hour and will stop working mid-demo.
GEMINI_API_KEYS=
GROQ_API_KEYS=
# Optional third provider. Used by quizzes and memory extraction.
OPENROUTER_API_KEYS=

GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Which providers to try, and in what order, for quizzes and memory.
AI_PROVIDER_ORDER=gemini,groq,openrouter

# Optional override for MoeAI's voice. Leave empty and lib/moeai/personality.md
# is used, which is where the personality actually lives and is reviewable in
# git. Setting it here hides the prompt from review, so prefer the file.
MOEAI_SYSTEM_PROMPT=

# ── Supabase ────────────────────────────────────────────────────────────
# The first two are public by design and safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ── Limits ──────────────────────────────────────────────────────────────
MOEAI_MAX_MESSAGES_PER_HOUR=40

# ── Cron ────────────────────────────────────────────────────────────────
# Vercel sends this as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://moe-ai-sable.vercel.app

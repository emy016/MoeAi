# ── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose. Used by API routes to write ai_logs.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI providers ────────────────────────────────────────────────────────
# Each provider accepts a COMMA-SEPARATED list of keys. The runtime rotates
# through them and skips a key that has been rate-limited (429) recently.
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=

# Optional model overrides (sensible defaults are baked in).
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Order the providers are tried in.
AI_PROVIDER_ORDER=gemini,groq,openrouter

# ── Limits (spending / abuse caps) ──────────────────────────────────────
MOEAI_MAX_MESSAGES_PER_HOUR=40
MOEAI_MAX_OUTPUT_TOKENS=1200

# ── Cron ────────────────────────────────────────────────────────────────
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://moe-ai.vercel.app

{
  "name": "edumoeai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:language": "node --experimental-strip-types scripts/check-language.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:keys && npm run check:app && npm run check:language && npm run check:emy && npm run check:logic && npm run check:subjects && npm run check:calendar && npm run check:markdown && npm run check:mobile && npm run build",
    "check:logic": "node --experimental-strip-types scripts/check-logic.ts",
    "check:markdown": "node scripts/check-markdown.mjs",
    "check:subjects": "node --experimental-strip-types scripts/check-subjects.ts",
    "check:mobile": "node scripts/check-mobile-strings.mjs",
    "check:calendar": "node --experimental-strip-types scripts/check-calendar.ts",
    "check:keys": "node --experimental-strip-types scripts/check-keys.ts",
    "build:app": "bash scripts/build-app.sh",
    "check:app": "node scripts/check-app-bundle.mjs",
    "check:emy": "node --experimental-strip-types scripts/check-emy.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.2",
    "katex": "^0.18.10",
    "lucide-react": "1.51.0",
    "mathjs": "15.2.0",
    "mermaid": "^12.1.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
